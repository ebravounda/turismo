# Aumentar límite de subida de archivos
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>

# Proteger config.php de acceso directo por HTTP
<Files "config.php">
    Order deny,allow
    Deny from all
</Files>

# Proteger setup.sql de acceso directo
<Files "*.sql">
    Order deny,allow
    Deny from all
</Files>
